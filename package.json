{
  "name": "playwright-e2e-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript E2E framework: UI, API, RBAC, multi-tenancy, network mocking and accessibility, against a self-contained demo app.",
  "private": true,
  "license": "MIT",
  "author": "Murilo Filho",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "app": "tsx app/src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox",
    "test:api": "playwright test --project=api",
    "test:chromium": "playwright test --project=chromium --project=api",
    "report": "playwright show-report"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
